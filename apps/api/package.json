{
  "name": "@wotao/review-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env DATABASE_URL=file:./dev.db tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --sourcemap",
    "start": "cross-env DATABASE_URL=file:./dev.db node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "cross-env DATABASE_URL=file:./dev.db prisma generate",
    "db:migrate": "cross-env DATABASE_URL=file:./dev.db prisma migrate deploy",
    "db:seed": "cross-env DATABASE_URL=file:./dev.db tsx prisma/seed.ts",
    "db:setup": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "test:db": "cross-env DATABASE_URL=file:./test.db node scripts/ensure-test-database.mjs && cross-env DATABASE_URL=file:./test.db prisma migrate reset --force --skip-generate --skip-seed",
    "test": "pnpm test:db && cross-env DATABASE_URL=file:./test.db vitest run"
  },
  "dependencies": {
    "@fastify/cors": "10.1.0",
    "@prisma/client": "6.19.0",
    "@wotao/contracts": "workspace:*",
    "dotenv": "17.2.3",
    "fastify": "5.6.2"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "cross-env": "10.1.0",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
