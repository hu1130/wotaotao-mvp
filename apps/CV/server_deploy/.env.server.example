DEPLOY_ROLE=server

# Replace these before deployment.
API_KEY=change-me-api-key
API_SECRET=change-me-api-secret
TENANT_ID=default
# Optional multi-tenant credentials. The legacy API_KEY/API_SECRET always bind
# to the default tenant. Example:
# TENANT_API_CREDENTIALS_JSON={"tenant-a-key":{"tenant_id":"tenant-a","secret":"change-me"}}
TENANT_API_CREDENTIALS_JSON=
CONTROL_AUTH_ENABLED=1
CONTROL_USERNAME=admin
CONTROL_PASSWORD=change-me-control-password
CONTROL_AUTH_MAX_FAILURES=5
CONTROL_AUTH_WINDOW_SECONDS=300
CONTROL_AUTH_LOCK_SECONDS=600
CONTROL_SESSION_SECONDS=43200
CONTROL_DEFAULT_TENANT_NAME=默认企业
TENANT_ADMIN_SESSION_TTL_SECONDS=43200
TENANT_ADMIN_SESSION_CACHE_SECONDS=30
TENANT_ADMIN_DOCUMENT_MAX_BYTES=26214400

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_THREADPOOL_TOKENS=64
RECOGNITION_MAX_CONCURRENCY=16
RECOGNITION_QUEUE_TIMEOUT_SECONDS=0.25
VOICE_MAX_CONCURRENCY=20
VOICE_QUEUE_TIMEOUT_SECONDS=0.1
VOICE_TICKET_TTL_SECONDS=60
DEVICE_ENROLLMENT_ENABLED=1
DEVICE_ACTIVATION_DEFAULT_TTL_HOURS=24
DEVICE_AUTH_CACHE_TTL_SECONDS=30
DEVICE_AUTH_NONCE_TTL_SECONDS=600
DEVICE_LAST_SEEN_UPDATE_SECONDS=60
AVATAR_BOOTSTRAP_TTL_SECONDS=60
AVATAR_SESSION_TTL_SECONDS=2592000
RUNTIME_SCOPE_LOCK_SHARDS=64
RUNTIME_SCOPE_IDLE_TTL_SECONDS=1800
RUNTIME_SCOPE_MAX_ENTRIES=2048
API_BASE_URL=http://api:8000
API_CORS_ORIGINS=*
DOCKER_API_PORT=8000
DOCKER_AVATAR_PORT=3456
NGINX_HTTP_PORT=80

# Database ports bind to localhost by default.
# For phase-one remote clients that still connect to databases directly,
# set this to the server intranet IP or 0.0.0.0 and restrict firewall rules.
DB_BIND_ADDRESS=127.0.0.1
MYSQL_PUBLIC_PORT=3306
PG_PUBLIC_PORT=5432
REDIS_PUBLIC_PORT=6379

MYSQL_USER=root
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_DATABASE=attendance
MYSQL_CHARSET=utf8mb4
MYSQL_TIME_ZONE=+08:00
MYSQL_POOL_SIZE=20
MYSQL_POOL_ACQUIRE_TIMEOUT_SECONDS=3

PG_USER=postgres
PG_PASSWORD=change-me-postgres-password
PG_DATABASE=face_db
PG_POOL_SIZE=20

REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=30
REDIS_POOL_MAX_OVERFLOW=10

USE_GPU=0
ENABLE_TTS_PREWARM=0
AVATAR_FIXED_SPEECH_DEDUP_SECONDS=1.5
FIXED_SPEECH_NOISE_GUARD_ENABLED=1
FIXED_SPEECH_POST_GUARD_MS=1200
ATTENDANCE_TIMEZONE=Asia/Shanghai
ATTENDANCE_CHECKOUT_AFTER_HOUR=18
ATTENDANCE_CHECKOUT_AFTER_MINUTE=0
HRMS_ATTENDANCE_SYNC_ENABLED=0
HRMS_ATTENDANCE_BASE_URL=https://hrms.shendux.com
HRMS_ATTENDANCE_API_KEY=
HRMS_ATTENDANCE_API_SECRET=
HRMS_ATTENDANCE_DEVICE_ID=
HRMS_ATTENDANCE_SYNC_TIMEOUT_SECONDS=5
HRMS_ATTENDANCE_SYNC_RETRY_SECONDS=60
HRMS_ATTENDANCE_EMPLOYEE_CACHE_SECONDS=300
HRMS_ATTENDANCE_SYNC_BATCH_SIZE=50
HRMS_ATTENDANCE_SYNC_WORKER_INTERVAL_SECONDS=30
HRMS_FRONTDESK_EMPLOYEE_SYNC_ENABLED=0
HRMS_FRONTDESK_EMPLOYEE_SYNC_INTERVAL_SECONDS=300
HRMS_FRONTDESK_TASK_POLL_SECONDS=15
HRMS_FRONTDESK_TASK_TARGET_DEVICE_ID=
CHECKED_IN_REENTRY_MIN_ABSENT_SECONDS=2.0
CHECKED_IN_REPEAT_REENTRY_MIN_ABSENT_SECONDS=20.0
CHECKED_IN_ABSENT_GRACE_SECONDS=2.0
PERSON_ARRIVAL_TASK_TRIGGER_COOLDOWN_SECONDS=30.0
CHECKED_IN_STRANGER_SUPPRESS_SECONDS=5.0
IDENTITY_TRAJECTORY_MAX_GAP_SECONDS=3
IDENTITY_TRAJECTORY_RETENTION_SECONDS=10
IDENTITY_TRAJECTORY_MIN_NEAREST_SIMILARITY=0.22
CLEAR_TEST_DATA=0
ENABLE_REALTIME_DIALOG=0
VOICE_PIPELINE_ENABLED=1
VOICE_PIPELINE_BACKEND=cascade
VOICE_PIPELINE_CLIENT_VAD_FALLBACK_MS=8000
PERSON_SESSION_ACQUIRE_SECONDS=2
PERSON_SESSION_ABSENT_SECONDS=15
PERSON_SESSION_SILENT_RELEASE_SECONDS=180
PERSON_SESSION_SWEEP_SECONDS=1
PERSON_SESSION_MEMORY_CONTEXT_MESSAGES=6
PERSON_SESSION_RECALL_CONTEXT_MESSAGES=20
VOICE_AGENT_INTENT_ROUTER_ENABLED=1
VOICE_AGENT_INTENT_MIN_CONFIDENCE=0.75
AGENT_SIGNAL_STREAM_ENABLED=1
AGENT_SIGNAL_REDIS_STREAM=agent:signals
AGENT_SIGNAL_STREAM_MAXLEN=1000
CLIENT_API_ONLY=0
KNOWLEDGE_BASE_DIR=/app/knowledge_base
KNOWLEDGE_ALLOWED_ROOTS=/app/knowledge_base

# LLM/RAG keys. Keep empty to disable provider-backed answers where applicable.
DAILY_QUOTES_API_KEY=
KNOWLEDGE_EMBEDDING_API_KEY=
KNOWLEDGE_ANSWER_API_KEY=
DIALOG_CHAT_API_KEY=
DIALOG_CHAT_RAG_ENABLED=1
DIALOG_CHAT_MAX_TOKENS=180
DIALOG_SCENE_REPLY_TEMPERATURE=0.85
DIALOG_SCENE_REPLY_MAX_TOKENS=90
DIALOG_CHAT_HTTP_POOL_CONNECTIONS=8
DIALOG_CHAT_HTTP_POOL_MAXSIZE=32
DIALOG_CHAT_ENABLE_THINKING=0
DIALOG_CHAT_RAG_TOP_K=4
DIALOG_CHAT_RAG_MIN_SCORE=0.12
DIALOG_CHAT_RAG_FALLBACK_TO_LLM=1
DIALOG_CHAT_RAG_MAX_CONTEXT_CHARS=3500
DIALOG_CHAT_INTENT_ROUTER_ENABLED=1
DIALOG_CHAT_INTENT_ROUTER_PROBE_KNOWLEDGE=1
DIALOG_CHAT_INTENT_ROUTER_PROBE_TOP_K=1
DIALOG_CHAT_INTENT_ROUTER_MIN_SCORE=0.12
DIALOG_CHAT_INTENT_EMBEDDING_ENABLED=1
DIALOG_CHAT_INTENT_EMBEDDING_MIN_SCORE=0.72
DIALOG_CHAT_DEFAULT_COMPANY_RAG_MIN_SCORE=0.35
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_TTS_APP_KEY=
VOLC_TTS_ACCESS_KEY=
FIXED_TTS_PROVIDER=volc
RAW_TTS_CACHE_ENABLED=0
FIXED_TTS_ALLOW_EDGE_FALLBACK=0
FIXED_TTS_TENANT_ID=default
FIXED_TTS_TIMEOUT_SECONDS=45
TTS_VOICE_NATORI=zh_male_yunzhou_jupiter_bigtts

# End-to-end Omni S2S. Set VOICE_PIPELINE_BACKEND=omni after the service is enabled.
REALTIME_DIALOG_DYNAMIC_NO_CACHE=1
REALTIME_DIALOG_APP_ID=
REALTIME_DIALOG_ACCESS_KEY=
REALTIME_DIALOG_BASE_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
REALTIME_DIALOG_RESOURCE_ID=volc.speech.dialog
REALTIME_DIALOG_MODEL=1.2.1.1
REALTIME_DIALOG_SPEAKER=zh_female_vv_jupiter_bigtts
REALTIME_DIALOG_OUTPUT_FORMAT=pcm_s16le
REALTIME_DIALOG_OUTPUT_SAMPLE_RATE=24000
VOICE_ASSISTANT_NAME=叮当
VOICE_ASSISTANT_WAKE_ALIASES=叮当,小叮当
VOICE_ASSISTANT_WAKE_ENABLED=1
VOICE_ASSISTANT_WAKE_REPLY=我在呢
REALTIME_DIALOG_BOT_NAME=叮当
REALTIME_DIALOG_SYSTEM_ROLE=你是公司前台数字人叮当，性格开朗、亲切、有一点害羞。用户喊“叮当”是在叫你，你要知道这是你的名字。你正在接待来访者和同事。说话要有真人感，像日常聊天一样有自然的停顿和节奏，不要像朗读课文。
REALTIME_DIALOG_ENABLE_CUSTOM_VAD=1
REALTIME_DIALOG_END_SMOOTH_WINDOW_MS=1800
# Client stop -> Omni final ASR/server VAD deadline, including silence padding.
REALTIME_DIALOG_ASR_FINAL_TIMEOUT_SECONDS=6
REALTIME_DIALOG_EMPTY_ASR_FINAL_TIMEOUT_SECONDS=2.5
REALTIME_DIALOG_ENABLE_LOUDNESS_NORM=1
REALTIME_DIALOG_SPEECH_RATE=0
REALTIME_DIALOG_LOUDNESS_RATE=0
REALTIME_DIALOG_RAG_ENABLED=1
REALTIME_DIALOG_RAG_TOP_K=4
REALTIME_DIALOG_RAG_MIN_SCORE=0.12
REALTIME_DIALOG_RAG_MAX_CHARS=3500
# Deprecated compatibility fallback for first-audio wait.
REALTIME_DIALOG_RAG_GATE_TIMEOUT_SECONDS=20
REALTIME_DIALOG_RAG_FIRST_AUDIO_TIMEOUT_SECONDS=6
REALTIME_DIALOG_RAG_COMPLETION_TIMEOUT_SECONDS=25
REALTIME_DIALOG_RAG_SERIAL_TIMEOUT_SECONDS=8
REALTIME_DIALOG_PING_INTERVAL_SECONDS=20
REALTIME_DIALOG_PING_TIMEOUT_SECONDS=10
REALTIME_DIALOG_CLOSE_TIMEOUT_SECONDS=5

# Tenant-isolated O2.0 cloned voice. Keep the platform switch off until probe succeeds.
VOICE_CLONE_PLATFORM_ENABLED=0
VOLC_VOICE_CLONE_APP_ID=
VOLC_VOICE_CLONE_ACCESS_TOKEN=
VOLC_VOICE_CLONE_TRAIN_RESOURCE_ID=seed-icl-2.0
VOLC_VOICE_CLONE_STATUS_RESOURCE_ID=volc.megatts.voiceclone
VOLC_VOICE_CLONE_MODEL_TYPE=4
VOLC_VOICE_CLONE_UPLOAD_URL=https://openspeech.bytedance.com/api/v1/mega_tts/audio/upload
VOLC_VOICE_CLONE_STATUS_URL=https://openspeech.bytedance.com/api/v1/mega_tts/status
VOICE_PROFILE_CACHE_TTL_SECONDS=60
# <=0 keeps a ready cloned-voice profile from expiring by age.
VOICE_PROFILE_PROBE_TTL_SECONDS=0
VOICE_SHARED_PROFILE_TENANT_ID=platform-shared

# Identity-bound long-term person memory. Extractor defaults to DIALOG_CHAT_*,
# and embeddings default to KNOWLEDGE_EMBEDDING_* when overrides are empty.
PERSON_MEMORY_ENABLED=1
PERSON_MEMORY_IMPLICIT_EXTRACTION_ENABLED=1
PERSON_MEMORY_REQUIRE_EMBEDDINGS=1
PERSON_MEMORY_EXTRACTOR_API_BASE=
PERSON_MEMORY_EXTRACTOR_API_KEY=
PERSON_MEMORY_EXTRACTOR_MODEL=
PERSON_MEMORY_EXTRACTOR_TIMEOUT_SECONDS=45
PERSON_MEMORY_EXTRACTOR_MAX_TOKENS=1200
PERSON_MEMORY_EXTRACTOR_VERSION=person-memory-v1
PERSON_MEMORY_EMBEDDING_API_BASE=
PERSON_MEMORY_EMBEDDING_API_KEY=
PERSON_MEMORY_EMBEDDING_MODEL=
PERSON_MEMORY_EMBEDDING_DIM=1024
PERSON_MEMORY_EMBEDDING_TIMEOUT_SECONDS=30
PERSON_MEMORY_EMBEDDING_BATCH_SIZE=16
PERSON_MEMORY_DEBOUNCE_SECONDS=15
PERSON_MEMORY_WORKER_POLL_SECONDS=1
PERSON_MEMORY_WORKER_LEASE_SECONDS=120
PERSON_MEMORY_WORKER_BATCH_SIZE=8
PERSON_MEMORY_WORKER_MAX_ATTEMPTS=5
PERSON_MEMORY_FACT_CONFIDENCE_THRESHOLD=0.78
PERSON_MEMORY_RETRIEVAL_TOP_K=6
PERSON_MEMORY_SESSION_TOP_K=6
PERSON_MEMORY_DAILY_SUMMARY_ENABLED=1
PERSON_MEMORY_DAILY_SUMMARY_POLL_SECONDS=60
PERSON_MEMORY_DAILY_SUMMARY_TOP_K=3
PERSON_MEMORY_DAILY_SUMMARY_MAX_TURNS=80
PERSON_MEMORY_DAILY_SUMMARY_MAX_CHARS=12000
PERSON_MEMORY_DAILY_SUMMARY_VERSION=person-memory-daily-summary-v1
PERSON_MEMORY_CONTEXT_MAX_CHARS=2200
PERSON_MEMORY_PROFILE_MAX_CHARS=900
PERSON_MEMORY_RECENT_CONTEXT_MESSAGES=20
