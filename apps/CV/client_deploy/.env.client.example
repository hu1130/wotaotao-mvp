DEPLOY_ROLE=collector
DEVICE_ID=
TENANT_ID=
SITE_ID=default

API_KEY=
API_SECRET=

# Replace server-ip with the Linux server intranet or public IP.
API_BASE_URL=http://server-ip:8000
AVATAR_SERVER_URL=http://server-ip:3456
CLIENT_API_ONLY=1
CLIENT_DEVICE_ENROLLMENT=auto
CLIENT_ACTIVATION_CODE=
CLIENT_DEVICE_IDENTITY_PATH=
CLIENT_APP_VERSION=1.1.0
CLIENT_OPEN_AVATAR_BROWSER=1
CLIENT_AVATAR_BROWSER_URL=
CLIENT_BROWSER_APP_MODE=1
CLIENT_BROWSER_AUTOPLAY=1
CLIENT_BROWSER_TRUST_INSECURE_ORIGIN=1
CLIENT_BROWSER_USER_DATA_DIR=
CLIENT_TASKS_ENABLED=1
CLIENT_TASK_POLL_SECONDS=2

# API-only clients do not need database ports. These remain only for legacy local mode.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me-mysql-password
MYSQL_DATABASE=attendance
MYSQL_CHARSET=utf8mb4
MYSQL_TIME_ZONE=+08:00
MYSQL_POOL_SIZE=5

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me-postgres-password
PG_DATABASE=face_db
PG_POOL_SIZE=5

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

CAMERA_INDEX=0
FRAME_WIDTH=1280
FRAME_HEIGHT=720
CAMERA_BUFFER_SIZE=1
ENABLE_GUI=0
USE_GPU=0
ATTENDANCE_CHECKOUT_AFTER_HOUR=18
ATTENDANCE_CHECKOUT_AFTER_MINUTE=0
CHECKED_IN_REENTRY_MIN_ABSENT_SECONDS=2.0
CHECKED_IN_REPEAT_REENTRY_MIN_ABSENT_SECONDS=20.0
TRACKER_BACKEND=bytetrack
BYTETRACK_DETECT_INTERVAL=3
BYTETRACK_TRACK_BUFFER=30
BYTETRACK_MATCH_THRESHOLD=0.3
GESTURE_ENABLED=0
ENABLE_REALTIME_DIALOG=0
REALTIME_DIALOG_APP_KEY=
VOICE_PIPELINE_ENABLED=0
ENABLE_TTS_PREWARM=0
TTS_VOICE_NATORI=zh_male_yunzhou_jupiter_bigtts
