{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.enterprise-balance.changed.v1/envelope.schema.json",
  "title": "EnterpriseBalanceChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "EnterpriseBalanceChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "EnterpriseBalance"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "availableFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "frozenFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "withdrawingFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "balanceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "lastLedgerEntryId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable le_ identifier",
          "pattern": "^le_[A-Za-z0-9_-]+$"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enterpriseId",
        "availableFen",
        "frozenFen",
        "withdrawingFen",
        "balanceVersion",
        "lastLedgerEntryId",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.enterprise-balance.changed.v1/payload.schema.json",
      "title": "EnterpriseBalanceChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Cache invalidation only; never a cash metric input.",
  "examples": [
    {
      "eventId": "evt_enterprisebalancechanged_001",
      "eventType": "EnterpriseBalanceChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "EnterpriseBalance",
      "aggregateId": "ent_contract_001",
      "aggregateVersion": 4,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ENTERPRISE_BALANCE:ent_contract_001:4",
      "payload": {
        "enterpriseId": "ent_contract_001",
        "availableFen": 120000,
        "frozenFen": 3000,
        "withdrawingFen": 20000,
        "balanceVersion": 4,
        "lastLedgerEntryId": "le_contract_001",
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.enterprise-balance.changed.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01"
  ],
  "x-idempotency-key-format": "ENTERPRISE_BALANCE:{enterpriseId}:{balanceVersion}"
}
