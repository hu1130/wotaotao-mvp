{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.anomaly.detected.v1/envelope.schema.json",
  "title": "LedgerAnomalyDetected envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "LedgerAnomalyDetected"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "LedgerAnomaly"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "anomalyId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable lan_ identifier",
          "pattern": "^lan_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anomalyType": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        },
        "objectType": {
          "type": "string",
          "minLength": 1
        },
        "objectId": {
          "type": "string",
          "minLength": 1
        },
        "assigneeRole": {
          "type": "string",
          "minLength": 1
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "OPEN"
          ]
        },
        "anomalyVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "detectedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "anomalyId",
        "enterpriseId",
        "anomalyType",
        "severity",
        "objectType",
        "objectId",
        "assigneeRole",
        "traceId",
        "status",
        "anomalyVersion",
        "detectedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.anomaly.detected.v1/payload.schema.json",
      "title": "LedgerAnomalyDetected payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "anomalyId + anomalyVersion",
  "examples": [
    {
      "eventId": "evt_ledgeranomalydetected_001",
      "eventType": "LedgerAnomalyDetected",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "LedgerAnomaly",
      "aggregateId": "lan_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "LEDGER_ANOMALY:lan_contract_001:1",
      "payload": {
        "anomalyId": "lan_contract_001",
        "enterpriseId": "ent_contract_001",
        "anomalyType": "LEDGER_PROJECTION_MISMATCH",
        "severity": "HIGH",
        "objectType": "Journal",
        "objectId": "jrnl_contract_001",
        "assigneeRole": "PLATFORM_FINANCE",
        "traceId": "trace_contract_fixture_001",
        "status": "OPEN",
        "anomalyVersion": 1,
        "detectedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.anomaly.detected.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01",
    "SYS-06"
  ],
  "x-idempotency-key-format": "LEDGER_ANOMALY:{anomalyId}:{anomalyVersion}"
}
