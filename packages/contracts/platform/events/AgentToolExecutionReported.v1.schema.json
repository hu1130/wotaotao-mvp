{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/platform.agent.tool-execution-reported.v1/envelope.schema.json",
  "title": "AgentToolExecutionReported envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "AgentToolExecutionReported"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "REGISTERED_DOMAIN_ADAPTER"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "AgentRun"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "agentRunId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable arun_ identifier",
          "pattern": "^arun_[A-Za-z0-9_-]+$"
        },
        "toolRunId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable trun_ identifier",
          "pattern": "^trun_[A-Za-z0-9_-]+$"
        },
        "toolCallId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable tcall_ identifier",
              "pattern": "^tcall_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolCode": {
          "type": "string",
          "minLength": 1
        },
        "domainSystem": {
          "type": "string",
          "enum": [
            "SYS-04",
            "SYS-05"
          ]
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "businessRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "description": "Monotonically increasing source version"
              }
            },
            "required": [
              "type",
              "id",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "inputVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "status": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "PARTIAL"
          ]
        },
        "billingPoint": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "retryable": {
          "type": "boolean"
        },
        "resultVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "toolAuthorizationRef": {
          "type": "string",
          "minLength": 1
        },
        "resultSummary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Non-sensitive result summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reportedAt": {
          "type": "string",
          "format": "date-time"
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "agentRunId",
        "toolRunId",
        "toolCallId",
        "toolCode",
        "domainSystem",
        "enterpriseId",
        "businessRefs",
        "inputVersion",
        "status",
        "billingPoint",
        "retryable",
        "resultVersion",
        "toolAuthorizationRef",
        "resultSummary",
        "failureCode",
        "reportedAt",
        "traceId"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/platform.agent.tool-execution-reported.v1/payload.schema.json",
      "title": "AgentToolExecutionReported payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "SYS-04 MarketingAgentExecutionReported and SYS-05 ContentPublishingAgentExecutionReported are aliases normalized into this message with the same toolRunId/resultVersion/payloadHash.",
  "examples": [
    {
      "eventId": "evt_agenttoolexecutionreported_001",
      "eventType": "AgentToolExecutionReported",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "REGISTERED_DOMAIN_ADAPTER",
      "environment": "DEV",
      "audience": [
        "SYS-01"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "AgentRun",
      "aggregateId": "arun_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "AGENT_TOOL_RESULT:arun_contract_001:trun_contract_001:1",
      "payload": {
        "agentRunId": "arun_contract_001",
        "toolRunId": "trun_contract_001",
        "toolCallId": "tcall_contract_001",
        "toolCode": "CONTENT_PUBLISH",
        "domainSystem": "SYS-05",
        "enterpriseId": "ent_contract_001",
        "businessRefs": [
          {
            "type": "ChannelPublication",
            "id": "cpub_contract_001",
            "version": 1
          }
        ],
        "inputVersion": 1,
        "status": "SUCCEEDED",
        "billingPoint": "PUBLICATION_ACCEPTED",
        "retryable": false,
        "resultVersion": 1,
        "toolAuthorizationRef": "tauth_contract_001",
        "resultSummary": "Publication result recorded",
        "failureCode": null,
        "reportedAt": "2026-08-10T02:00:00Z",
        "traceId": "trace_contract_fixture_001"
      }
    }
  ],
  "x-topic": "platform.agent.tool-execution-reported.v1",
  "x-producer": "REGISTERED_DOMAIN_ADAPTER",
  "x-consumers": [
    "SYS-01"
  ],
  "x-idempotency-key-format": "AGENT_TOOL_RESULT:{agentRunId}:{toolRunId}:{resultVersion}"
}
