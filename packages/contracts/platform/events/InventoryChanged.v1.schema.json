{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.inventory.changed.v1/envelope.schema.json",
  "title": "InventoryChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "InventoryChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-03"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-02",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Inventory"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable store_ identifier",
          "pattern": "^store_[A-Za-z0-9_-]+$"
        },
        "skuId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable sku_ identifier",
          "pattern": "^sku_[A-Za-z0-9_-]+$"
        },
        "availableQuantity": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enterpriseId",
        "storeId",
        "skuId",
        "availableQuantity",
        "inventoryVersion",
        "reasonCode",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.inventory.changed.v1/payload.schema.json",
      "title": "InventoryChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "This invalidates display caches; checkout still performs an authoritative reservation.",
  "examples": [
    {
      "eventId": "evt_inventorychanged_001",
      "eventType": "InventoryChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-03",
      "environment": "DEV",
      "audience": [
        "SYS-02",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "Inventory",
      "aggregateId": "sku_contract_001",
      "aggregateVersion": 4,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "INVENTORY_CHANGED:sku_contract_001:4",
      "payload": {
        "enterpriseId": "ent_contract_001",
        "storeId": "store_contract_001",
        "skuId": "sku_contract_001",
        "availableQuantity": 98,
        "inventoryVersion": 4,
        "reasonCode": "MANUAL_ADJUSTMENT",
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "commerce.inventory.changed.v1",
  "x-producer": "SYS-03",
  "x-consumers": [
    "SYS-02",
    "SYS-06"
  ],
  "x-idempotency-key-format": "INVENTORY_CHANGED:{skuId}:{inventoryVersion}"
}
