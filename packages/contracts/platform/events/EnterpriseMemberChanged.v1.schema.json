{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/platform.enterprise.member_changed.v1/envelope.schema.json",
  "title": "EnterpriseMemberChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "EnterpriseMemberChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-01"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-03",
          "SYS-04",
          "SYS-05",
          "SYS-06",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "EnterpriseMember"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "enterpriseMemberId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable emr_ identifier",
          "pattern": "^emr_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable usr_ identifier",
          "pattern": "^usr_[A-Za-z0-9_-]+$"
        },
        "changeType": {
          "type": "string",
          "enum": [
            "BOUND",
            "ROLE_CHANGED",
            "SUSPENDED",
            "RESUMED",
            "REMOVED"
          ]
        },
        "roleCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "dataScope": {
          "type": "object",
          "description": "Normalized, non-secret authorization data scope",
          "additionalProperties": true
        },
        "memberStatus": {
          "type": "string",
          "enum": [
            "ACTIVE",
            "SUSPENDED",
            "REMOVED"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "PLATFORM_CONTROLLED_BINDING",
            "FUTURE_INVITATION"
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time"
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "enterpriseMemberId",
        "enterpriseId",
        "userId",
        "changeType",
        "roleCodes",
        "dataScope",
        "memberStatus",
        "source",
        "version",
        "effectiveAt",
        "reasonCode"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/platform.enterprise.member_changed.v1/payload.schema.json",
      "title": "EnterpriseMemberChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "enterpriseMemberId + version; one active enterprise/user relationship",
  "examples": [
    {
      "eventId": "evt_enterprisememberchanged_001",
      "eventType": "EnterpriseMemberChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-01",
      "environment": "DEV",
      "audience": [
        "SYS-03",
        "SYS-04",
        "SYS-05",
        "SYS-06",
        "SYS-08"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "EnterpriseMember",
      "aggregateId": "emr_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ENTERPRISE_MEMBER:emr_contract_001:2",
      "payload": {
        "enterpriseMemberId": "emr_contract_001",
        "enterpriseId": "ent_contract_001",
        "userId": "usr_contract_001",
        "changeType": "ROLE_CHANGED",
        "roleCodes": [
          "ENTERPRISE_ADMIN"
        ],
        "dataScope": {
          "storeIds": [
            "store_contract_001"
          ]
        },
        "memberStatus": "ACTIVE",
        "source": "PLATFORM_CONTROLLED_BINDING",
        "version": 2,
        "effectiveAt": "2026-08-10T02:00:00Z",
        "reasonCode": "ADMIN_APPROVED"
      }
    }
  ],
  "x-topic": "platform.enterprise.member_changed.v1",
  "x-producer": "SYS-01",
  "x-consumers": [
    "SYS-03",
    "SYS-04",
    "SYS-05",
    "SYS-06",
    "SYS-08"
  ],
  "x-idempotency-key-format": "ENTERPRISE_MEMBER:{enterpriseMemberId}:{version}"
}
