{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.order.attribution-frozen.v1/envelope.schema.json",
  "title": "OrderAttributionFrozen envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "OrderAttributionFrozen"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-02"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-04",
          "SYS-06",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "OrderAttribution"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ord_ identifier",
          "pattern": "^ord_[A-Za-z0-9_-]+$"
        },
        "subOrderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable subord_ identifier",
          "pattern": "^subord_[A-Za-z0-9_-]+$"
        },
        "attributionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable atr_ identifier",
          "pattern": "^atr_[A-Za-z0-9_-]+$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "sourceType": {
          "type": "string",
          "minLength": 1
        },
        "sellerEnterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "promoterEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "membershipOwnerEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attributionRuleVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "distributionRuleVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "distributionContextStatus": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "PENDING_DISTRIBUTION_RULE"
          ]
        },
        "distributionContextVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "description": "Monotonically increasing source version"
            },
            {
              "type": "null"
            }
          ]
        },
        "distributionContextHash": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Lower-case SHA-256 digest",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frozenAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "subOrderId",
        "attributionId",
        "version",
        "reviewStatus",
        "sourceType",
        "sellerEnterpriseId",
        "promoterEnterpriseId",
        "membershipOwnerEnterpriseId",
        "attributionRuleVersion",
        "distributionRuleVersionId",
        "distributionContextStatus",
        "distributionContextVersion",
        "distributionContextHash",
        "snapshotHash",
        "frozenAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.order.attribution-frozen.v1/payload.schema.json",
      "title": "OrderAttributionFrozen payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "attributionId + version; version 1 is frozen with the order transaction",
  "examples": [
    {
      "eventId": "evt_orderattributionfrozen_001",
      "eventType": "OrderAttributionFrozen",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-02",
      "environment": "DEV",
      "audience": [
        "SYS-04",
        "SYS-06",
        "SYS-08"
      ],
      "enterpriseId": null,
      "aggregateType": "OrderAttribution",
      "aggregateId": "atr_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ORDER_ATTRIBUTION:atr_contract_001:1",
      "payload": {
        "orderId": "ord_contract_001",
        "subOrderId": "subord_contract_001",
        "attributionId": "atr_contract_001",
        "version": 1,
        "reviewStatus": "APPROVED",
        "sourceType": "CONTENT_CLICK",
        "sellerEnterpriseId": "ent_contract_001",
        "promoterEnterpriseId": "ent_contract_002",
        "membershipOwnerEnterpriseId": "ent_contract_001",
        "attributionRuleVersion": 1,
        "distributionRuleVersionId": "dru_contract_001",
        "distributionContextStatus": "RESOLVED",
        "distributionContextVersion": 1,
        "distributionContextHash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "snapshotHash": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
        "frozenAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "commerce.order.attribution-frozen.v1",
  "x-producer": "SYS-02",
  "x-consumers": [
    "SYS-04",
    "SYS-06",
    "SYS-08"
  ],
  "x-idempotency-key-format": "ORDER_ATTRIBUTION:{attributionId}:{version}"
}
