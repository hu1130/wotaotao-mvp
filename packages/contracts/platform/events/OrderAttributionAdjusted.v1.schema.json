{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.order.attribution-adjusted.v1/envelope.schema.json",
  "title": "OrderAttributionAdjusted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "OrderAttributionAdjusted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-02"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-04",
          "SYS-06",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "OrderAttribution"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ord_ identifier",
          "pattern": "^ord_[A-Za-z0-9_-]+$"
        },
        "subOrderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable subord_ identifier",
          "pattern": "^subord_[A-Za-z0-9_-]+$"
        },
        "attributionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable atr_ identifier",
          "pattern": "^atr_[A-Za-z0-9_-]+$"
        },
        "adjustmentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable adj_ identifier",
          "pattern": "^adj_[A-Za-z0-9_-]+$"
        },
        "oldVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "newVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "oldSellerEnterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "newSellerEnterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "oldPromoterEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "newPromoterEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldMembershipOwnerEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "newMembershipOwnerEnterpriseId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable ent_ identifier",
              "pattern": "^ent_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldDistributionRuleVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "newDistributionRuleVersionId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "oldDistributionContextStatus": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "PENDING_DISTRIBUTION_RULE"
          ]
        },
        "newDistributionContextStatus": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "PENDING_DISTRIBUTION_RULE"
          ]
        },
        "oldSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "newSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1
        },
        "effectiveAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "subOrderId",
        "attributionId",
        "adjustmentId",
        "oldVersion",
        "newVersion",
        "oldSellerEnterpriseId",
        "newSellerEnterpriseId",
        "oldPromoterEnterpriseId",
        "newPromoterEnterpriseId",
        "oldMembershipOwnerEnterpriseId",
        "newMembershipOwnerEnterpriseId",
        "oldDistributionRuleVersionId",
        "newDistributionRuleVersionId",
        "oldDistributionContextStatus",
        "newDistributionContextStatus",
        "oldSnapshotHash",
        "newSnapshotHash",
        "approvalRef",
        "effectiveAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.order.attribution-adjusted.v1/payload.schema.json",
      "title": "OrderAttributionAdjusted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "adjustmentId + newVersion; corrections append and never overwrite",
  "examples": [
    {
      "eventId": "evt_orderattributionadjusted_001",
      "eventType": "OrderAttributionAdjusted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-02",
      "environment": "DEV",
      "audience": [
        "SYS-04",
        "SYS-06",
        "SYS-08"
      ],
      "enterpriseId": null,
      "aggregateType": "OrderAttribution",
      "aggregateId": "atr_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ORDER_ATTRIBUTION_ADJUST:adj_contract_001:2",
      "payload": {
        "orderId": "ord_contract_001",
        "subOrderId": "subord_contract_001",
        "attributionId": "atr_contract_001",
        "adjustmentId": "adj_contract_001",
        "oldVersion": 1,
        "newVersion": 2,
        "oldSellerEnterpriseId": "ent_contract_001",
        "newSellerEnterpriseId": "ent_contract_001",
        "oldPromoterEnterpriseId": null,
        "newPromoterEnterpriseId": "ent_contract_002",
        "oldMembershipOwnerEnterpriseId": "ent_contract_001",
        "newMembershipOwnerEnterpriseId": "ent_contract_001",
        "oldDistributionRuleVersionId": null,
        "newDistributionRuleVersionId": "dru_contract_001",
        "oldDistributionContextStatus": "PENDING_DISTRIBUTION_RULE",
        "newDistributionContextStatus": "RESOLVED",
        "oldSnapshotHash": "1111111111111111111111111111111111111111111111111111111111111111",
        "newSnapshotHash": "2222222222222222222222222222222222222222222222222222222222222222",
        "approvalRef": "approval_contract_001",
        "effectiveAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "commerce.order.attribution-adjusted.v1",
  "x-producer": "SYS-02",
  "x-consumers": [
    "SYS-04",
    "SYS-06",
    "SYS-08"
  ],
  "x-idempotency-key-format": "ORDER_ATTRIBUTION_ADJUST:{adjustmentId}:{newVersion}"
}
