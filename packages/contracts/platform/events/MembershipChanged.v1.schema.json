{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.membership.changed.v1/envelope.schema.json",
  "title": "MembershipChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "MembershipChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-05",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Membership"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "membershipId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable mem_ identifier",
          "pattern": "^mem_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "planCode": {
          "type": "string",
          "minLength": 1
        },
        "planVersionId": {
          "type": "string",
          "minLength": 1
        },
        "ruleVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "status": {
          "type": "string",
          "enum": [
            "FREE",
            "ACTIVE",
            "EXPIRED",
            "CANCELLED"
          ]
        },
        "startsAt": {
          "type": "string",
          "format": "date-time"
        },
        "endsAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "membershipVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "membershipId",
        "enterpriseId",
        "planCode",
        "planVersionId",
        "ruleVersion",
        "status",
        "startsAt",
        "endsAt",
        "membershipVersion",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.membership.changed.v1/payload.schema.json",
      "title": "MembershipChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "This is an entitlement state, not a cash receipt.",
  "examples": [
    {
      "eventId": "evt_membershipchanged_001",
      "eventType": "MembershipChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-05",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "Membership",
      "aggregateId": "mem_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "MEMBERSHIP:mem_contract_001:2",
      "payload": {
        "membershipId": "mem_contract_001",
        "enterpriseId": "ent_contract_001",
        "planCode": "PRO",
        "planVersionId": "mpv_contract_001",
        "ruleVersion": 1,
        "status": "ACTIVE",
        "startsAt": "2026-08-10T02:00:00Z",
        "endsAt": "2027-08-10T02:00:00Z",
        "membershipVersion": 2,
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.membership.changed.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01",
    "SYS-05",
    "SYS-06"
  ],
  "x-idempotency-key-format": "MEMBERSHIP:{membershipId}:{membershipVersion}"
}
