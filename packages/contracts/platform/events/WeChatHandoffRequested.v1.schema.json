{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/crm.wechat.handoff-requested.v1/envelope.schema.json",
  "title": "WeChatHandoffRequested envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "WeChatHandoffRequested"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-04"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "WeChatHandoff"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "handoffRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable whf_ identifier",
          "pattern": "^whf_[A-Za-z0-9_-]+$"
        },
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable conv_ identifier",
          "pattern": "^conv_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "customerId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable cus_ identifier",
              "pattern": "^cus_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "REQUESTED"
          ]
        },
        "handoffVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable mas_ identifier",
          "pattern": "^mas_[A-Za-z0-9_-]+$"
        },
        "analyticsSnapshotVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "handoffRef",
        "conversationId",
        "enterpriseId",
        "customerId",
        "reasonCode",
        "status",
        "handoffVersion",
        "analyticsSnapshotRef",
        "analyticsSnapshotVersion",
        "analyticsSnapshotHash",
        "requestedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/crm.wechat.handoff-requested.v1/payload.schema.json",
      "title": "WeChatHandoffRequested payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "handoffRef + handoffVersion; one active handoff task per conversation",
  "examples": [
    {
      "eventId": "evt_wechathandoffrequested_001",
      "eventType": "WeChatHandoffRequested",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-04",
      "environment": "DEV",
      "audience": [
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "WeChatHandoff",
      "aggregateId": "whf_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "WECHAT_HANDOFF:whf_contract_001:1",
      "payload": {
        "handoffRef": "whf_contract_001",
        "conversationId": "conv_contract_001",
        "enterpriseId": "ent_contract_001",
        "customerId": "cus_contract_001",
        "reasonCode": "CUSTOMER_REQUESTED_HUMAN",
        "status": "REQUESTED",
        "handoffVersion": 1,
        "analyticsSnapshotRef": "mas_contract_handoff_001",
        "analyticsSnapshotVersion": 1,
        "analyticsSnapshotHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "requestedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "crm.wechat.handoff-requested.v1",
  "x-producer": "SYS-04",
  "x-consumers": [
    "SYS-06"
  ],
  "x-idempotency-key-format": "WECHAT_HANDOFF:{handoffRef}:{handoffVersion}"
}
