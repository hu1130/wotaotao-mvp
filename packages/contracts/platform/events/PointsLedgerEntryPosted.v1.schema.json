{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.points-entry.posted.v1/envelope.schema.json",
  "title": "PointsLedgerEntryPosted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "PointsLedgerEntryPosted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "PointsEntry"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "const": 1
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "pointsEntryId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pe_ identifier",
          "pattern": "^pe_[A-Za-z0-9_-]+$"
        },
        "pointsAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pa_ identifier",
          "pattern": "^pa_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "sourceOrChargeCode": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "EARN",
            "SPEND",
            "REFUND",
            "ADJUST"
          ]
        },
        "points": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer points amount"
        },
        "signedPoints": {
          "type": "integer"
        },
        "businessType": {
          "type": "string",
          "minLength": 1
        },
        "businessNo": {
          "type": "string",
          "minLength": 1
        },
        "agentRunId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable arun_ identifier",
              "pattern": "^arun_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "toolCallId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable tcall_ identifier",
              "pattern": "^tcall_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reservationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "originalPointsEntryId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable pe_ identifier",
              "pattern": "^pe_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "ruleVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "postedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pointsEntryId",
        "pointsAccountId",
        "enterpriseId",
        "sourceOrChargeCode",
        "direction",
        "points",
        "signedPoints",
        "businessType",
        "businessNo",
        "agentRunId",
        "toolCallId",
        "reservationId",
        "originalPointsEntryId",
        "ruleVersion",
        "postedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.points-entry.posted.v1/payload.schema.json",
      "title": "PointsLedgerEntryPosted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "REFUND/ADJUST append and reference the original entry; balances never replace this fact.",
  "examples": [
    {
      "eventId": "evt_pointsledgerentryposted_001",
      "eventType": "PointsLedgerEntryPosted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "PointsEntry",
      "aggregateId": "pe_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "POINTS_ENTRY:pe_contract_001",
      "payload": {
        "pointsEntryId": "pe_contract_001",
        "pointsAccountId": "pa_contract_001",
        "enterpriseId": "ent_contract_001",
        "sourceOrChargeCode": "AGENT_CONTENT_GENERATION",
        "direction": "SPEND",
        "points": 20,
        "signedPoints": -20,
        "businessType": "AGENT_TOOL",
        "businessNo": "arun_contract_001",
        "agentRunId": "arun_contract_001",
        "toolCallId": "tcall_contract_001",
        "reservationId": "points_res_contract_001",
        "originalPointsEntryId": null,
        "ruleVersion": 1,
        "postedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.points-entry.posted.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01",
    "SYS-06"
  ],
  "x-idempotency-key-format": "POINTS_ENTRY:{pointsEntryId}"
}
