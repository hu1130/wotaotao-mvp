{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.order.refunded.v1/envelope.schema.json",
  "title": "OrderRefunded envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "OrderRefunded"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-02"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-03",
          "SYS-04",
          "SYS-06",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Order"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ord_ identifier",
          "pattern": "^ord_[A-Za-z0-9_-]+$"
        },
        "subOrderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable subord_ identifier",
          "pattern": "^subord_[A-Za-z0-9_-]+$"
        },
        "refundId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable rfd_ identifier",
          "pattern": "^rfd_[A-Za-z0-9_-]+$"
        },
        "sellerEnterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "storeId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable store_ identifier",
          "pattern": "^store_[A-Za-z0-9_-]+$"
        },
        "attributionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable atr_ identifier",
          "pattern": "^atr_[A-Za-z0-9_-]+$"
        },
        "buyerMatchRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "refundedFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "cumulativeRefundedFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "currency": {
          "type": "string",
          "enum": [
            "CNY"
          ]
        },
        "orderVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "outcomeVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable oas_ identifier",
          "pattern": "^oas_[A-Za-z0-9_-]+$"
        },
        "analyticsSnapshotVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "subOrderId",
        "refundId",
        "sellerEnterpriseId",
        "storeId",
        "attributionId",
        "buyerMatchRef",
        "refundedFen",
        "cumulativeRefundedFen",
        "currency",
        "orderVersion",
        "outcomeVersion",
        "analyticsSnapshotRef",
        "analyticsSnapshotVersion",
        "analyticsSnapshotHash",
        "completedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.order.refunded.v1/payload.schema.json",
      "title": "OrderRefunded payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "refundId + outcomeVersion; cumulative amount cannot exceed original paid amount",
  "examples": [
    {
      "eventId": "evt_orderrefunded_001",
      "eventType": "OrderRefunded",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-02",
      "environment": "DEV",
      "audience": [
        "SYS-03",
        "SYS-04",
        "SYS-06",
        "SYS-08"
      ],
      "enterpriseId": null,
      "aggregateType": "Order",
      "aggregateId": "ord_contract_001",
      "aggregateVersion": 5,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "REFUND_RESULT:rfd_contract_001:rtxn_contract_001",
      "payload": {
        "orderId": "ord_contract_001",
        "subOrderId": "subord_contract_001",
        "refundId": "rfd_contract_001",
        "sellerEnterpriseId": "ent_contract_001",
        "storeId": "store_contract_001",
        "attributionId": "atr_contract_001",
        "buyerMatchRef": "buyer_match_contract_001",
        "refundedFen": 2900,
        "cumulativeRefundedFen": 2900,
        "currency": "CNY",
        "orderVersion": 5,
        "outcomeVersion": 2,
        "analyticsSnapshotRef": "oas_contract_002",
        "analyticsSnapshotVersion": 2,
        "analyticsSnapshotHash": "6666666666666666666666666666666666666666666666666666666666666666",
        "completedAt": "2026-08-10T02:02:00Z"
      }
    }
  ],
  "x-topic": "commerce.order.refunded.v1",
  "x-producer": "SYS-02",
  "x-consumers": [
    "SYS-03",
    "SYS-04",
    "SYS-06",
    "SYS-08"
  ],
  "x-idempotency-key-format": "REFUND_RESULT:{refundId}:{channelRefundTransactionId}"
}
