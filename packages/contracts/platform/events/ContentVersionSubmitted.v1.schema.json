{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/content.version.submitted.v1/envelope.schema.json",
  "title": "ContentVersionSubmitted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ContentVersionSubmitted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-05"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "ContentChannelVersion"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "contentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cnt_ identifier",
          "pattern": "^cnt_[A-Za-z0-9_-]+$"
        },
        "channelVersionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cver_ identifier",
          "pattern": "^cver_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "WOTAO",
            "DOUYIN"
          ]
        },
        "contentVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable csub_ identifier",
          "pattern": "^csub_[A-Za-z0-9_-]+$"
        },
        "snapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "submittedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Stable usr_ identifier",
          "pattern": "^usr_[A-Za-z0-9_-]+$"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contentId",
        "channelVersionId",
        "enterpriseId",
        "channel",
        "contentVersion",
        "submissionId",
        "snapshotHash",
        "submittedBy",
        "submittedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/content.version.submitted.v1/payload.schema.json",
      "title": "ContentVersionSubmitted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "channelVersionId + contentVersion; submitted snapshot is immutable",
  "examples": [
    {
      "eventId": "evt_contentversionsubmitted_001",
      "eventType": "ContentVersionSubmitted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-05",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "ContentChannelVersion",
      "aggregateId": "cver_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "CONTENT_SUBMIT:cver_contract_001:2",
      "payload": {
        "contentId": "cnt_contract_001",
        "channelVersionId": "cver_contract_001",
        "enterpriseId": "ent_contract_001",
        "channel": "DOUYIN",
        "contentVersion": 2,
        "submissionId": "csub_contract_001",
        "snapshotHash": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "submittedBy": "usr_contract_001",
        "submittedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "content.version.submitted.v1",
  "x-producer": "SYS-05",
  "x-consumers": [
    "SYS-01",
    "SYS-06"
  ],
  "x-idempotency-key-format": "CONTENT_SUBMIT:{channelVersionId}:{contentVersion}"
}
