{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.profit-base.reversed.v1/envelope.schema.json",
  "title": "ProfitBaseReversed envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ProfitBaseReversed"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "ProfitBase"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "profitBaseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pb_ identifier",
          "pattern": "^pb_[A-Za-z0-9_-]+$"
        },
        "originalAllocationVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "reversalBatchId": {
          "type": "string",
          "minLength": 1
        },
        "reversalLedgerRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "Stable le_ identifier",
            "pattern": "^le_[A-Za-z0-9_-]+$"
          },
          "minItems": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "approvalRef": {
          "type": "string",
          "minLength": 1
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "reversedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "profitBaseId",
        "originalAllocationVersion",
        "reversalBatchId",
        "reversalLedgerRefs",
        "reasonCode",
        "approvalRef",
        "sourceVersion",
        "reversedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.profit-base.reversed.v1/payload.schema.json",
      "title": "ProfitBaseReversed payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "profitBaseId + original allocation version; reversal appends",
  "examples": [
    {
      "eventId": "evt_profitbasereversed_001",
      "eventType": "ProfitBaseReversed",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-06"
      ],
      "enterpriseId": null,
      "aggregateType": "ProfitBase",
      "aggregateId": "pb_contract_001",
      "aggregateVersion": 3,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "PROFIT_REVERSE:pb_contract_001:2",
      "payload": {
        "profitBaseId": "pb_contract_001",
        "originalAllocationVersion": 2,
        "reversalBatchId": "revbatch_contract_001",
        "reversalLedgerRefs": [
          "le_contract_reversal_001"
        ],
        "reasonCode": "ATTRIBUTION_ADJUSTED",
        "approvalRef": "approval_contract_006",
        "sourceVersion": 3,
        "reversedAt": "2026-08-18T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.profit-base.reversed.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-06"
  ],
  "x-idempotency-key-format": "PROFIT_REVERSE:{profitBaseId}:{originalAllocationVersion}"
}
