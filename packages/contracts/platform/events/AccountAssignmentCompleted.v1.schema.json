{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/opc.account-assignment.completed.v1/envelope.schema.json",
  "title": "AccountAssignmentCompleted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "AccountAssignmentCompleted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-07"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-05"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "AccountAssignment"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "accountAssignmentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable aasg_ identifier",
          "pattern": "^aasg_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "publicationPlanId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pplan_ identifier",
          "pattern": "^pplan_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "assignmentRequestVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "providerId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable prov_ identifier",
          "pattern": "^prov_[A-Za-z0-9_-]+$"
        },
        "opcAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable opca_ identifier",
          "pattern": "^opca_[A-Za-z0-9_-]+$"
        },
        "channelAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable chacc_ identifier",
          "pattern": "^chacc_[A-Za-z0-9_-]+$"
        },
        "assignmentSnapshotVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "assignmentVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "assignedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "accountAssignmentId",
        "enterpriseId",
        "publicationPlanId",
        "channelPublicationId",
        "assignmentRequestVersion",
        "providerId",
        "opcAccountId",
        "channelAccountId",
        "assignmentSnapshotVersion",
        "assignmentVersion",
        "sourceVersion",
        "assignedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/opc.account-assignment.completed.v1/payload.schema.json",
      "title": "AccountAssignmentCompleted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Session authorization is a synchronous API, not an event. It must bind accountAssignmentId + channelPublicationId + executionId + assignmentSnapshotVersion.",
  "examples": [
    {
      "eventId": "evt_accountassignmentcompleted_001",
      "eventType": "AccountAssignmentCompleted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-07",
      "environment": "DEV",
      "audience": [
        "SYS-05"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "AccountAssignment",
      "aggregateId": "aasg_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ACCOUNT_ASSIGNMENT_RESULT:cpub_contract_001:1",
      "payload": {
        "accountAssignmentId": "aasg_contract_001",
        "enterpriseId": "ent_contract_001",
        "publicationPlanId": "pplan_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "assignmentRequestVersion": 1,
        "providerId": "prov_contract_001",
        "opcAccountId": "opca_contract_001",
        "channelAccountId": "chacc_contract_001",
        "assignmentSnapshotVersion": 1,
        "assignmentVersion": 1,
        "sourceVersion": 2,
        "assignedAt": "2026-08-10T02:01:00Z"
      }
    }
  ],
  "x-topic": "opc.account-assignment.completed.v1",
  "x-producer": "SYS-07",
  "x-consumers": [
    "SYS-05"
  ],
  "x-idempotency-key-format": "ACCOUNT_ASSIGNMENT_RESULT:{channelPublicationId}:{assignmentRequestVersion}"
}
