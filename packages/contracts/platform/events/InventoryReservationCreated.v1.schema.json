{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.inventory-reservation.created.v1/envelope.schema.json",
  "title": "InventoryReservationCreated envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "InventoryReservationCreated"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-03"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-02"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "InventoryReservation"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "commandId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cmd_ identifier",
          "pattern": "^cmd_[A-Za-z0-9_-]+$"
        },
        "reservationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ires_ identifier",
          "pattern": "^ires_[A-Za-z0-9_-]+$"
        },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ord_ identifier",
          "pattern": "^ord_[A-Za-z0-9_-]+$"
        },
        "subOrderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable subord_ identifier",
          "pattern": "^subord_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "reservationVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "itemSummaryHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "result": {
          "type": "string",
          "enum": [
            "RESERVED"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "traceId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "commandId",
        "reservationId",
        "orderId",
        "subOrderId",
        "enterpriseId",
        "reservationVersion",
        "expiresAt",
        "itemSummaryHash",
        "result",
        "createdAt",
        "traceId"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.inventory-reservation.created.v1/payload.schema.json",
      "title": "InventoryReservationCreated payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "one active reservationId per orderId; commandId is globally unique",
  "examples": [
    {
      "eventId": "evt_inventoryreservationcreated_001",
      "eventType": "InventoryReservationCreated",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-03",
      "environment": "DEV",
      "audience": [
        "SYS-02"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "InventoryReservation",
      "aggregateId": "ires_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "INVENTORY_RESERVE:ord_contract_001",
      "payload": {
        "commandId": "cmd_inventory_reserve_001",
        "reservationId": "ires_contract_001",
        "orderId": "ord_contract_001",
        "subOrderId": "subord_contract_001",
        "enterpriseId": "ent_contract_001",
        "reservationVersion": 1,
        "expiresAt": "2026-08-10T02:15:00Z",
        "itemSummaryHash": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "result": "RESERVED",
        "createdAt": "2026-08-10T02:00:00Z",
        "traceId": "trace_contract_fixture_001"
      }
    }
  ],
  "x-topic": "commerce.inventory-reservation.created.v1",
  "x-producer": "SYS-03",
  "x-consumers": [
    "SYS-02"
  ],
  "x-idempotency-key-format": "INVENTORY_RESERVE:{orderId}"
}
