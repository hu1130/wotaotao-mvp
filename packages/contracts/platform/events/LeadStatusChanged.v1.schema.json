{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/crm.lead.status_changed.v1/envelope.schema.json",
  "title": "LeadStatusChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "LeadStatusChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-04"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Lead"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "leadId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable lead_ identifier",
          "pattern": "^lead_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "customerId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable cus_ identifier",
              "pattern": "^cus_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "oldStatus": {
          "type": "string",
          "minLength": 1
        },
        "newStatus": {
          "type": "string",
          "minLength": 1
        },
        "validityStatus": {
          "type": "string",
          "enum": [
            "VALID",
            "INVALID",
            "PENDING_AUTHORIZATION"
          ]
        },
        "authorizationStatus": {
          "type": "string",
          "minLength": 1
        },
        "globalRefusalStatus": {
          "type": "string",
          "minLength": 1
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "leadVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable mas_ identifier",
          "pattern": "^mas_[A-Za-z0-9_-]+$"
        },
        "analyticsSnapshotVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "leadId",
        "enterpriseId",
        "customerId",
        "oldStatus",
        "newStatus",
        "validityStatus",
        "authorizationStatus",
        "globalRefusalStatus",
        "reasonCode",
        "leadVersion",
        "analyticsSnapshotRef",
        "analyticsSnapshotVersion",
        "analyticsSnapshotHash",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/crm.lead.status_changed.v1/payload.schema.json",
      "title": "LeadStatusChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "leadId + leadVersion",
  "examples": [
    {
      "eventId": "evt_leadstatuschanged_001",
      "eventType": "LeadStatusChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-04",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "Lead",
      "aggregateId": "lead_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "CRM_LEAD_STATUS:lead_contract_001:2",
      "payload": {
        "leadId": "lead_contract_001",
        "enterpriseId": "ent_contract_001",
        "customerId": "cus_contract_001",
        "oldStatus": "NEW",
        "newStatus": "QUALIFIED",
        "validityStatus": "VALID",
        "authorizationStatus": "AUTHORIZED",
        "globalRefusalStatus": "NONE",
        "reasonCode": "HUMAN_QUALIFIED",
        "leadVersion": 2,
        "analyticsSnapshotRef": "mas_contract_lead_002",
        "analyticsSnapshotVersion": 2,
        "analyticsSnapshotHash": "8888888888888888888888888888888888888888888888888888888888888888",
        "changedAt": "2026-08-10T02:05:00Z"
      }
    }
  ],
  "x-topic": "crm.lead.status_changed.v1",
  "x-producer": "SYS-04",
  "x-consumers": [
    "SYS-01",
    "SYS-06"
  ],
  "x-idempotency-key-format": "CRM_LEAD_STATUS:{leadId}:{leadVersion}"
}
