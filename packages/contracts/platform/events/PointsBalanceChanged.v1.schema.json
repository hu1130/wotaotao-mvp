{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.points-balance.changed.v1/envelope.schema.json",
  "title": "PointsBalanceChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "PointsBalanceChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "PointsAccount"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "pointsAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pa_ identifier",
          "pattern": "^pa_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "availablePoints": {
          "type": "integer",
          "minimum": 0
        },
        "reservedPoints": {
          "type": "integer",
          "minimum": 0
        },
        "balanceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "lastPointsEntryId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pe_ identifier",
          "pattern": "^pe_[A-Za-z0-9_-]+$"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "pointsAccountId",
        "enterpriseId",
        "availablePoints",
        "reservedPoints",
        "balanceVersion",
        "lastPointsEntryId",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.points-balance.changed.v1/payload.schema.json",
      "title": "PointsBalanceChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Cache invalidation only; PointsLedgerEntryPosted is the points fact source.",
  "examples": [
    {
      "eventId": "evt_pointsbalancechanged_001",
      "eventType": "PointsBalanceChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "PointsAccount",
      "aggregateId": "pa_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "POINTS_BALANCE:pa_contract_001:2",
      "payload": {
        "pointsAccountId": "pa_contract_001",
        "enterpriseId": "ent_contract_001",
        "availablePoints": 980,
        "reservedPoints": 0,
        "balanceVersion": 2,
        "lastPointsEntryId": "pe_contract_001",
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.points-balance.changed.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01"
  ],
  "x-idempotency-key-format": "POINTS_BALANCE:{pointsAccountId}:{balanceVersion}"
}
