{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/publication.account-assignment.release-requested.v1/envelope.schema.json",
  "title": "AccountAssignmentReleaseRequested envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "AccountAssignmentReleaseRequested"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-05"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-07"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "AccountAssignment"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "accountAssignmentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable aasg_ identifier",
          "pattern": "^aasg_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable exec_ identifier",
          "pattern": "^exec_[A-Za-z0-9_-]+$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "PUBLICATION_COMPLETED",
            "CANCELLED",
            "TERMINATED",
            "FINAL_FAILED"
          ]
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "accountAssignmentId",
        "enterpriseId",
        "channelPublicationId",
        "executionId",
        "reason",
        "sourceVersion",
        "requestedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/publication.account-assignment.release-requested.v1/payload.schema.json",
      "title": "AccountAssignmentReleaseRequested payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Never send while external execution status is unknown.",
  "examples": [
    {
      "eventId": "evt_accountassignmentreleaserequested_001",
      "eventType": "AccountAssignmentReleaseRequested",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-05",
      "environment": "DEV",
      "audience": [
        "SYS-07"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "AccountAssignment",
      "aggregateId": "aasg_contract_001",
      "aggregateVersion": 3,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ACCOUNT_ASSIGNMENT_RELEASE:aasg_contract_001",
      "payload": {
        "accountAssignmentId": "aasg_contract_001",
        "enterpriseId": "ent_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "executionId": "exec_contract_001",
        "reason": "PUBLICATION_COMPLETED",
        "sourceVersion": 3,
        "requestedAt": "2026-08-11T02:01:00Z"
      }
    }
  ],
  "x-topic": "publication.account-assignment.release-requested.v1",
  "x-producer": "SYS-05",
  "x-consumers": [
    "SYS-07"
  ],
  "x-idempotency-key-format": "ACCOUNT_ASSIGNMENT_RELEASE:{accountAssignmentId}"
}
