{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/crm.call.completed.v1/envelope.schema.json",
  "title": "CallCompleted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "CallCompleted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-04"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Call"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "callId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable call_ identifier",
          "pattern": "^call_[A-Za-z0-9_-]+$"
        },
        "callTaskId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ctask_ identifier",
          "pattern": "^ctask_[A-Za-z0-9_-]+$"
        },
        "callCampaignId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ccmp_ identifier",
          "pattern": "^ccmp_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cus_ identifier",
          "pattern": "^cus_[A-Za-z0-9_-]+$"
        },
        "resultVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "status": {
          "type": "string",
          "enum": [
            "COMPLETED"
          ]
        },
        "connected": {
          "type": "boolean"
        },
        "durationSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "intentLevel": {
          "type": "string",
          "minLength": 1
        },
        "humanFollowupRequired": {
          "type": "boolean"
        },
        "isRealAiCall": {
          "type": "boolean",
          "const": true
        },
        "analyticsSnapshotRef": {
          "type": "string",
          "minLength": 1,
          "description": "Stable mas_ identifier",
          "pattern": "^mas_[A-Za-z0-9_-]+$"
        },
        "analyticsSnapshotVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "analyticsSnapshotHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "callId",
        "callTaskId",
        "callCampaignId",
        "enterpriseId",
        "customerId",
        "resultVersion",
        "status",
        "connected",
        "durationSeconds",
        "intentLevel",
        "humanFollowupRequired",
        "isRealAiCall",
        "analyticsSnapshotRef",
        "analyticsSnapshotVersion",
        "analyticsSnapshotHash",
        "completedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/crm.call.completed.v1/payload.schema.json",
      "title": "CallCompleted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "trusted providerAccountId + callId + resultVersion",
  "examples": [
    {
      "eventId": "evt_callcompleted_001",
      "eventType": "CallCompleted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-04",
      "environment": "DEV",
      "audience": [
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "Call",
      "aggregateId": "call_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "AI_CALL_RESULT:provider_account_contract_001:call_contract_001:1",
      "payload": {
        "callId": "call_contract_001",
        "callTaskId": "ctask_contract_001",
        "callCampaignId": "ccmp_contract_001",
        "enterpriseId": "ent_contract_001",
        "customerId": "cus_contract_001",
        "resultVersion": 1,
        "status": "COMPLETED",
        "connected": true,
        "durationSeconds": 92,
        "intentLevel": "HIGH",
        "humanFollowupRequired": true,
        "isRealAiCall": true,
        "analyticsSnapshotRef": "mas_contract_call_001",
        "analyticsSnapshotVersion": 1,
        "analyticsSnapshotHash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "completedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "crm.call.completed.v1",
  "x-producer": "SYS-04",
  "x-consumers": [
    "SYS-06"
  ],
  "x-idempotency-key-format": "AI_CALL_RESULT:{providerAccountId}:{callId}:{resultVersion}"
}
