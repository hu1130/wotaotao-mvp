{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.content.product-clicked.v1/envelope.schema.json",
  "title": "ContentProductClicked envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ContentProductClicked"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-02"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-04",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "AttributionCandidate"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "attributionCandidateId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable atc_ identifier",
          "pattern": "^atc_[A-Za-z0-9_-]+$"
        },
        "contentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cnt_ identifier",
          "pattern": "^cnt_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "productId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable prd_ identifier",
          "pattern": "^prd_[A-Za-z0-9_-]+$"
        },
        "promoterEnterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "customerId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable cus_ identifier",
              "pattern": "^cus_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "anonymousId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable anon_ identifier",
              "pattern": "^anon_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "clickedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "attributionCandidateId",
        "contentId",
        "channelPublicationId",
        "productId",
        "promoterEnterpriseId",
        "customerId",
        "anonymousId",
        "clickedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.content.product-clicked.v1/payload.schema.json",
      "title": "ContentProductClicked payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "attributionCandidateId; eventId is an independent delivery dedupe key",
  "examples": [
    {
      "eventId": "evt_contentproductclicked_001",
      "eventType": "ContentProductClicked",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-02",
      "environment": "DEV",
      "audience": [
        "SYS-04",
        "SYS-06"
      ],
      "enterpriseId": null,
      "aggregateType": "AttributionCandidate",
      "aggregateId": "atc_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "CONTENT_PRODUCT_CLICK:atc_contract_001",
      "payload": {
        "attributionCandidateId": "atc_contract_001",
        "contentId": "cnt_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "productId": "prd_contract_001",
        "promoterEnterpriseId": "ent_contract_002",
        "customerId": null,
        "anonymousId": "anon_contract_001",
        "clickedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "commerce.content.product-clicked.v1",
  "x-producer": "SYS-02",
  "x-consumers": [
    "SYS-04",
    "SYS-06"
  ],
  "x-idempotency-key-format": "CONTENT_PRODUCT_CLICK:{attributionCandidateId}"
}
