{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/content.review.completed.v1/envelope.schema.json",
  "title": "ContentReviewCompleted envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ContentReviewCompleted"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "REVIEW_CENTER"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-05",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "ContentReview"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable crev_ identifier",
          "pattern": "^crev_[A-Za-z0-9_-]+$"
        },
        "contentId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cnt_ identifier",
          "pattern": "^cnt_[A-Za-z0-9_-]+$"
        },
        "channelVersionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cver_ identifier",
          "pattern": "^cver_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "contentVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "decision": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED"
          ]
        },
        "decisionVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidenceHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reviewId",
        "contentId",
        "channelVersionId",
        "enterpriseId",
        "contentVersion",
        "decision",
        "decisionVersion",
        "reasonCodes",
        "evidenceHash",
        "completedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/content.review.completed.v1/payload.schema.json",
      "title": "ContentReviewCompleted payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "reviewId + decisionVersion; one decision per submitted content version",
  "examples": [
    {
      "eventId": "evt_contentreviewcompleted_001",
      "eventType": "ContentReviewCompleted",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "REVIEW_CENTER",
      "environment": "DEV",
      "audience": [
        "SYS-05",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "ContentReview",
      "aggregateId": "crev_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "CONTENT_REVIEW:crev_contract_001:1",
      "payload": {
        "reviewId": "crev_contract_001",
        "contentId": "cnt_contract_001",
        "channelVersionId": "cver_contract_001",
        "enterpriseId": "ent_contract_001",
        "contentVersion": 2,
        "decision": "APPROVED",
        "decisionVersion": 1,
        "reasonCodes": [],
        "evidenceHash": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
        "completedAt": "2026-08-10T02:05:00Z"
      }
    }
  ],
  "x-topic": "content.review.completed.v1",
  "x-producer": "REVIEW_CENTER",
  "x-consumers": [
    "SYS-05",
    "SYS-06"
  ],
  "x-idempotency-key-format": "CONTENT_REVIEW:{reviewId}:{decisionVersion}"
}
