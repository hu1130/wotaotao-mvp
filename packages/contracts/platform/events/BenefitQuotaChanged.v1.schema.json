{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.benefit-quota.changed.v1/envelope.schema.json",
  "title": "BenefitQuotaChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "BenefitQuotaChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01",
          "SYS-05",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "BenefitQuota"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "quotaAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable bqa_ identifier",
          "pattern": "^bqa_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "benefitCode": {
          "type": "string",
          "minLength": 1
        },
        "availableCount": {
          "type": "integer",
          "minimum": 0
        },
        "reservedCount": {
          "type": "integer",
          "minimum": 0
        },
        "usedCount": {
          "type": "integer",
          "minimum": 0
        },
        "expiredCount": {
          "type": "integer",
          "minimum": 0
        },
        "changeReason": {
          "type": "string",
          "minLength": 1
        },
        "businessNo": {
          "type": "string",
          "minLength": 1
        },
        "quotaVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "quotaAccountId",
        "enterpriseId",
        "benefitCode",
        "availableCount",
        "reservedCount",
        "usedCount",
        "expiredCount",
        "changeReason",
        "businessNo",
        "quotaVersion",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.benefit-quota.changed.v1/payload.schema.json",
      "title": "BenefitQuotaChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "Quota counts must never be converted into points or money.",
  "examples": [
    {
      "eventId": "evt_benefitquotachanged_001",
      "eventType": "BenefitQuotaChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-01",
        "SYS-05",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "BenefitQuota",
      "aggregateId": "bqa_contract_001",
      "aggregateVersion": 3,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "BENEFIT_QUOTA:bqa_contract_001:3",
      "payload": {
        "quotaAccountId": "bqa_contract_001",
        "enterpriseId": "ent_contract_001",
        "benefitCode": "DOUYIN_VIDEO_PUBLICATION",
        "availableCount": 4,
        "reservedCount": 1,
        "usedCount": 0,
        "expiredCount": 0,
        "changeReason": "PUBLICATION_RESERVED",
        "businessNo": "cpub_contract_001",
        "quotaVersion": 3,
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.benefit-quota.changed.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-01",
    "SYS-05",
    "SYS-06"
  ],
  "x-idempotency-key-format": "BENEFIT_QUOTA:{quotaAccountId}:{quotaVersion}"
}
