{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/commerce.aftersale.status-changed.v1/envelope.schema.json",
  "title": "AftersaleStatusChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "AftersaleStatusChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-02"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-03",
          "SYS-06",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "Aftersale"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "aftersaleId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable afs_ identifier",
          "pattern": "^afs_[A-Za-z0-9_-]+$"
        },
        "orderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ord_ identifier",
          "pattern": "^ord_[A-Za-z0-9_-]+$"
        },
        "subOrderId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable subord_ identifier",
          "pattern": "^subord_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "responsibleParty": {
          "type": "string",
          "enum": [
            "BUYER",
            "MERCHANT",
            "PLATFORM",
            "SUPPLIER"
          ]
        },
        "approvedFen": {
          "type": "integer",
          "minimum": 0,
          "description": "Non-negative integer amount in fen"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "decisionVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "approvalRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "aftersaleId",
        "orderId",
        "subOrderId",
        "enterpriseId",
        "status",
        "responsibleParty",
        "approvedFen",
        "version",
        "decisionVersion",
        "approvalRef",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/commerce.aftersale.status-changed.v1/payload.schema.json",
      "title": "AftersaleStatusChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "aftersaleId + version",
  "examples": [
    {
      "eventId": "evt_aftersalestatuschanged_001",
      "eventType": "AftersaleStatusChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-02",
      "environment": "DEV",
      "audience": [
        "SYS-03",
        "SYS-06",
        "SYS-08"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "Aftersale",
      "aggregateId": "afs_contract_001",
      "aggregateVersion": 2,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "AFTERSALE_STATUS:afs_contract_001:2",
      "payload": {
        "aftersaleId": "afs_contract_001",
        "orderId": "ord_contract_001",
        "subOrderId": "subord_contract_001",
        "enterpriseId": "ent_contract_001",
        "status": "APPROVED",
        "responsibleParty": "MERCHANT",
        "approvedFen": 2900,
        "version": 2,
        "decisionVersion": 1,
        "approvalRef": "approval_contract_002",
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "commerce.aftersale.status-changed.v1",
  "x-producer": "SYS-02",
  "x-consumers": [
    "SYS-03",
    "SYS-06",
    "SYS-08"
  ],
  "x-idempotency-key-format": "AFTERSALE_STATUS:{aftersaleId}:{version}"
}
