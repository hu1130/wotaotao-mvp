{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/platform.identity.user.registered.v1/envelope.schema.json",
  "title": "UserRegistered envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "UserRegistered"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-01"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-01"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "User"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable usr_ identifier",
          "pattern": "^usr_[A-Za-z0-9_-]+$"
        },
        "userVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "registrationMethod": {
          "type": "string",
          "enum": [
            "PHONE",
            "OAUTH"
          ]
        },
        "clientType": {
          "type": "string",
          "enum": [
            "WORKBENCH",
            "MALL",
            "OPC",
            "ADMIN"
          ]
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "userVersion",
        "registrationMethod",
        "clientType",
        "registeredAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/platform.identity.user.registered.v1/payload.schema.json",
      "title": "UserRegistered payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "userId + userVersion",
  "examples": [
    {
      "eventId": "evt_userregistered_001",
      "eventType": "UserRegistered",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-01",
      "environment": "DEV",
      "audience": [
        "SYS-01"
      ],
      "enterpriseId": null,
      "aggregateType": "User",
      "aggregateId": "usr_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "USER_REGISTERED:usr_contract_001:1",
      "payload": {
        "userId": "usr_contract_001",
        "userVersion": 1,
        "registrationMethod": "PHONE",
        "clientType": "WORKBENCH",
        "registeredAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "platform.identity.user.registered.v1",
  "x-producer": "SYS-01",
  "x-consumers": [
    "SYS-01"
  ],
  "x-idempotency-key-format": "USER_REGISTERED:{userId}:{userVersion}"
}
