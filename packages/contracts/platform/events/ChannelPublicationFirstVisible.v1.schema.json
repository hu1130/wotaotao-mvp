{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/publication.channel.first_visible.v1/envelope.schema.json",
  "title": "ChannelPublicationFirstVisible envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ChannelPublicationFirstVisible"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-05"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-06",
          "SYS-07",
          "SYS-08"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "ChannelPublication"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "publicationPlanId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pplan_ identifier",
          "pattern": "^pplan_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "executionId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable exec_ identifier",
          "pattern": "^exec_[A-Za-z0-9_-]+$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "WOTAO",
            "DOUYIN"
          ]
        },
        "externalWorkRef": {
          "type": "string",
          "minLength": 1
        },
        "douyinExecutionMode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "SELF_ACCOUNT",
                "PLATFORM_OPERATED",
                "OPC_RENTED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "accountOwnershipType": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ENTERPRISE_OWNED",
                "PLATFORM_OWNED",
                "OPC_RENTED"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "accountAssignmentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable aasg_ identifier",
              "pattern": "^aasg_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "firstVisibleAt": {
          "type": "string",
          "format": "date-time"
        },
        "evidenceSnapshotRef": {
          "type": "string",
          "minLength": 1
        },
        "evidenceHash": {
          "type": "string",
          "minLength": 1,
          "description": "Lower-case SHA-256 digest",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        }
      },
      "required": [
        "enterpriseId",
        "publicationPlanId",
        "channelPublicationId",
        "executionId",
        "channel",
        "externalWorkRef",
        "douyinExecutionMode",
        "accountOwnershipType",
        "accountAssignmentId",
        "firstVisibleAt",
        "evidenceSnapshotRef",
        "evidenceHash",
        "sourceVersion"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/publication.channel.first_visible.v1/payload.schema.json",
      "title": "ChannelPublicationFirstVisible payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "first visibility freezes once per channelPublicationId; evidence hash is immutable",
  "examples": [
    {
      "eventId": "evt_channelpublicationfirstvisible_001",
      "eventType": "ChannelPublicationFirstVisible",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-05",
      "environment": "DEV",
      "audience": [
        "SYS-06",
        "SYS-07",
        "SYS-08"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "ChannelPublication",
      "aggregateId": "cpub_contract_001",
      "aggregateVersion": 3,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "PUBLICATION_FIRST_VISIBLE:cpub_contract_001",
      "payload": {
        "enterpriseId": "ent_contract_001",
        "publicationPlanId": "pplan_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "executionId": "exec_contract_001",
        "channel": "DOUYIN",
        "externalWorkRef": "douyin_work_safe_contract_001",
        "douyinExecutionMode": "OPC_RENTED",
        "accountOwnershipType": "OPC_RENTED",
        "accountAssignmentId": "aasg_contract_001",
        "firstVisibleAt": "2026-08-10T02:00:00Z",
        "evidenceSnapshotRef": "evidence_contract_001",
        "evidenceHash": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
        "sourceVersion": 3
      }
    }
  ],
  "x-topic": "publication.channel.first_visible.v1",
  "x-producer": "SYS-05",
  "x-consumers": [
    "SYS-06",
    "SYS-07",
    "SYS-08"
  ],
  "x-idempotency-key-format": "PUBLICATION_FIRST_VISIBLE:{channelPublicationId}"
}
