{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/ledger.publication.charge-reserved.v1/envelope.schema.json",
  "title": "ChannelPublicationReserved envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "ChannelPublicationReserved"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-08"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-05",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "PublicationChargeReservation"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "chargeReservationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pcr_ identifier",
          "pattern": "^pcr_[A-Za-z0-9_-]+$"
        },
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "publicationPlanId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pplan_ identifier",
          "pattern": "^pplan_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "DOUYIN"
          ]
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "BENEFIT_QUOTA",
            "PUBLICATION_SERVICE_ORDER",
            "AUTHORIZED_BALANCE"
          ]
        },
        "quotaBatchId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "serviceOrderId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable pso_ identifier",
              "pattern": "^pso_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "paymentId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Stable pay_ identifier",
              "pattern": "^pay_[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorizedBalanceRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "reservedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "chargeReservationId",
        "enterpriseId",
        "publicationPlanId",
        "channelPublicationId",
        "channel",
        "sourceType",
        "quotaBatchId",
        "serviceOrderId",
        "paymentId",
        "authorizedBalanceRef",
        "sourceVersion",
        "expiresAt",
        "reservedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/ledger.publication.charge-reserved.v1/payload.schema.json",
      "title": "ChannelPublicationReserved payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "PUBLICATION_CHARGE is the frozen API/event business key; legacy PUB_CHARGE_RESERVE is not accepted.",
  "examples": [
    {
      "eventId": "evt_channelpublicationreserved_001",
      "eventType": "ChannelPublicationReserved",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-08",
      "environment": "DEV",
      "audience": [
        "SYS-05",
        "SYS-06"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "PublicationChargeReservation",
      "aggregateId": "pcr_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "PUBLICATION_CHARGE:cpub_contract_001",
      "payload": {
        "chargeReservationId": "pcr_contract_001",
        "enterpriseId": "ent_contract_001",
        "publicationPlanId": "pplan_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "channel": "DOUYIN",
        "sourceType": "PUBLICATION_SERVICE_ORDER",
        "quotaBatchId": null,
        "serviceOrderId": "pso_contract_001",
        "paymentId": "pay_service_contract_001",
        "authorizedBalanceRef": null,
        "sourceVersion": 1,
        "expiresAt": "2026-08-10T03:00:00Z",
        "reservedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "ledger.publication.charge-reserved.v1",
  "x-producer": "SYS-08",
  "x-consumers": [
    "SYS-05",
    "SYS-06"
  ],
  "x-idempotency-key-format": "PUBLICATION_CHARGE:{channelPublicationId}"
}
