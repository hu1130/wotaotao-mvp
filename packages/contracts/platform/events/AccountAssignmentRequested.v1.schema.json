{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/publication.account-assignment.requested.v1/envelope.schema.json",
  "title": "AccountAssignmentRequested envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "AccountAssignmentRequested"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-05"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-07"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "ChannelPublication"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "enterpriseId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        "publicationPlanId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable pplan_ identifier",
          "pattern": "^pplan_[A-Za-z0-9_-]+$"
        },
        "channelPublicationId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable cpub_ identifier",
          "pattern": "^cpub_[A-Za-z0-9_-]+$"
        },
        "channel": {
          "type": "string",
          "enum": [
            "DOUYIN"
          ]
        },
        "requiredAccountOwnershipType": {
          "type": "string",
          "enum": [
            "OPC_RENTED"
          ]
        },
        "constraints": {
          "type": "object",
          "description": "Non-secret matching constraints",
          "additionalProperties": true
        },
        "assignmentRequestVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "sourceVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "enterpriseId",
        "publicationPlanId",
        "channelPublicationId",
        "channel",
        "requiredAccountOwnershipType",
        "constraints",
        "assignmentRequestVersion",
        "sourceVersion",
        "requestedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/publication.account-assignment.requested.v1/payload.schema.json",
      "title": "AccountAssignmentRequested payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "one result and one active assignment per channelPublicationId + assignmentRequestVersion",
  "examples": [
    {
      "eventId": "evt_accountassignmentrequested_001",
      "eventType": "AccountAssignmentRequested",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-05",
      "environment": "DEV",
      "audience": [
        "SYS-07"
      ],
      "enterpriseId": "ent_contract_001",
      "aggregateType": "ChannelPublication",
      "aggregateId": "cpub_contract_001",
      "aggregateVersion": 1,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "ACCOUNT_ASSIGNMENT_REQUEST:cpub_contract_001:1",
      "payload": {
        "enterpriseId": "ent_contract_001",
        "publicationPlanId": "pplan_contract_001",
        "channelPublicationId": "cpub_contract_001",
        "channel": "DOUYIN",
        "requiredAccountOwnershipType": "OPC_RENTED",
        "constraints": {
          "industryCode": "RETAIL"
        },
        "assignmentRequestVersion": 1,
        "sourceVersion": 2,
        "requestedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "publication.account-assignment.requested.v1",
  "x-producer": "SYS-05",
  "x-consumers": [
    "SYS-07"
  ],
  "x-idempotency-key-format": "ACCOUNT_ASSIGNMENT_REQUEST:{channelPublicationId}:{assignmentRequestVersion}"
}
