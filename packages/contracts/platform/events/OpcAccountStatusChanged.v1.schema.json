{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.wotaotao.com/events/opc.account.status-changed.v1/envelope.schema.json",
  "title": "OpcAccountStatusChanged envelope v1",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable evt_ identifier",
      "pattern": "^evt_[A-Za-z0-9_-]+$"
    },
    "eventType": {
      "type": "string",
      "const": "OpcAccountStatusChanged"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "description": "Business occurrence time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Outbox publication time"
    },
    "producer": {
      "type": "string",
      "const": "SYS-07"
    },
    "environment": {
      "type": "string",
      "enum": [
        "DEV",
        "TEST",
        "STAGING",
        "PROD"
      ]
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "SYS-05",
          "SYS-06"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "enterpriseId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable ent_ identifier",
          "pattern": "^ent_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "aggregateType": {
      "type": "string",
      "const": "OpcAccount"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable aggregate identifier"
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic aggregate version"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Stable evt_ identifier",
          "pattern": "^evt_[A-Za-z0-9_-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "description": "Stable business idempotency key; unchanged on retry"
    },
    "payload": {
      "type": "object",
      "properties": {
        "providerId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable prov_ identifier",
          "pattern": "^prov_[A-Za-z0-9_-]+$"
        },
        "opcAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable opca_ identifier",
          "pattern": "^opca_[A-Za-z0-9_-]+$"
        },
        "channelAccountId": {
          "type": "string",
          "minLength": 1,
          "description": "Stable chacc_ identifier",
          "pattern": "^chacc_[A-Za-z0-9_-]+$"
        },
        "admissionStatus": {
          "type": "string",
          "minLength": 1
        },
        "operatingStatus": {
          "type": "string",
          "minLength": 1
        },
        "healthStatus": {
          "type": "string",
          "minLength": 1
        },
        "pauseReasonCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "accountVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing source version"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "providerId",
        "opcAccountId",
        "channelAccountId",
        "admissionStatus",
        "operatingStatus",
        "healthStatus",
        "pauseReasonCode",
        "accountVersion",
        "changedAt"
      ],
      "additionalProperties": false,
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://contracts.wotaotao.com/events/opc.account.status-changed.v1/payload.schema.json",
      "title": "OpcAccountStatusChanged payload v1"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "publishedAt",
    "producer",
    "environment",
    "audience",
    "enterpriseId",
    "aggregateType",
    "aggregateId",
    "aggregateVersion",
    "traceId",
    "causationId",
    "correlationId",
    "idempotencyKey",
    "payload"
  ],
  "additionalProperties": false,
  "description": "opcAccountId + accountVersion",
  "examples": [
    {
      "eventId": "evt_opcaccountstatuschanged_001",
      "eventType": "OpcAccountStatusChanged",
      "schemaVersion": 1,
      "occurredAt": "2026-08-10T02:00:00Z",
      "publishedAt": "2026-08-10T02:00:01Z",
      "producer": "SYS-07",
      "environment": "DEV",
      "audience": [
        "SYS-05",
        "SYS-06"
      ],
      "enterpriseId": null,
      "aggregateType": "OpcAccount",
      "aggregateId": "opca_contract_001",
      "aggregateVersion": 3,
      "traceId": "trace_contract_fixture_001",
      "causationId": null,
      "correlationId": "corr_contract_fixture_001",
      "idempotencyKey": "OPC_ACCOUNT_STATUS:opca_contract_001:3",
      "payload": {
        "providerId": "prov_contract_001",
        "opcAccountId": "opca_contract_001",
        "channelAccountId": "chacc_contract_001",
        "admissionStatus": "APPROVED",
        "operatingStatus": "ACTIVE",
        "healthStatus": "HEALTHY",
        "pauseReasonCode": null,
        "accountVersion": 3,
        "changedAt": "2026-08-10T02:00:00Z"
      }
    }
  ],
  "x-topic": "opc.account.status-changed.v1",
  "x-producer": "SYS-07",
  "x-consumers": [
    "SYS-05",
    "SYS-06"
  ],
  "x-idempotency-key-format": "OPC_ACCOUNT_STATUS:{opcAccountId}:{accountVersion}"
}
